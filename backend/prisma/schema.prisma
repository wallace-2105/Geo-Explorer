// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Emula o UUID e tipagem do auth.users do Supabase
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  firstName String
  lastName  String
  cpf       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trailProgress    TrailProgress[]
  challengeHistory ChallengeHistory[]
  certificates     Certificate[]

  @@map("users") // Usar o nome 'users' para separar do auth.users ou linkar de alguma forma
}

model TrailProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  trailId   String
  status    String   // not_started, in_progress, completed
  progress  Int      @default(0) // 0 a 100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Modulos completos em JSON para salvar progresso das lições
  completedModules Json?

  @@unique([userId, trailId])
  @@map("trail_progress")
}

model ChallengeHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  challengeId    String
  challengeTitle String
  technology     String
  level          String
  difficulty     String
  status         String   // passed, failed
  solvedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("challenge_history")
}

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  trailId       String
  trailTitle    String
  issueDate     DateTime @default(now())
  verifyCode    String   @unique
  pdfUrl        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}
